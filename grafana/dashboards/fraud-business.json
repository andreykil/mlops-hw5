          "rawQuery": true,
          "rawSql": "SELECT model_version AS \"Версия модели\", AVG(fraud_flag)::double precision AS \"Доля фрода\"\nFROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring})\nGROUP BY model_version ORDER BY model_version",
