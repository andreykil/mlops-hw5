    {
      "title": "Плотность распределения скоров",
      "type": "barchart",
      "description": "20 интервалов шириной 0.05. Площадь столбцов равна 1. Учитываются время, штат и мерчант.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "orientation": "vertical",
        "showValue": "auto",
        "groupWidth": 0.85,
        "barWidth": 0.9,
        "xTickLabelRotation": -60
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawQuery": true,
          "rawSql": "WITH filtered AS (\n    SELECT LEAST(FLOOR(score * 20)::int, 19) AS bin\n    FROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring})\n), counts AS (\n    SELECT bin, COUNT(*) AS n FROM filtered GROUP BY bin\n), total AS (\n    SELECT COUNT(*) AS n FROM filtered\n)\nSELECT to_char(b.bin / 20.0, 'FM0.00') || '–' ||\n       to_char((b.bin + 1) / 20.0, 'FM0.00') AS \"Скор\",\n       COALESCE(c.n, 0) * 20.0 / NULLIF(t.n, 0) AS \"Плотность\"\nFROM generate_series(0, 19) AS b(bin)\nLEFT JOIN counts c USING (bin) CROSS JOIN total t\nORDER BY b.bin",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "id": 3
    },
    {
      "title": "TPS выбранных транзакций",
      "type": "timeseries",
      "description": "Число отскоренных транзакций в десятисекундном интервале, делённое на 10. Учитываются оба фильтра.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
