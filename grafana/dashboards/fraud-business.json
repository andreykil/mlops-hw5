          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '10s', 0), COUNT(*) / 10.0 AS \"TPS\"\nFROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring})\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "id": 4
    },
    {
      "title": "Доля фрода по категориям: последние 1000",
      "type": "barchart",
      "description": "Последние 1000 записей всего потока (или все, если их меньше). Фильтры и период дашборда здесь не применяются.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.85,
        "barWidth": 0.9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n    SELECT cat_id, fraud_flag FROM scores ORDER BY id DESC LIMIT 1000\n)\nSELECT COALESCE(cat_id, 'неизвестно') AS \"Категория\",\n       AVG(fraud_flag)::double precision AS \"Доля фрода\"\nFROM latest GROUP BY cat_id ORDER BY \"Доля фрода\" DESC",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "id": 5
    },
    {
      "title": "Сумма операций с флагом фрода",
      "type": "timeseries",
      "description": "Показывает денежный объём подозрительных операций за минуту. Это предсказания модели, а не подтверждённые потери.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '1m', 0),\n       COALESCE(SUM(amount) FILTER (WHERE fraud_flag = 1), 0)::double precision AS \"Сумма\"\nFROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring})\nGROUP BY 1 ORDER BY 1",
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "id": 6
    }
